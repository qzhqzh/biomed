# Copy to .env before running Docker Compose.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.124.2
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0

BIOTOOLS_HOST_PORT=50011
BIOTOOLS_API_KEYS=
BIOTOOLS_REQUIRE_API_KEY=0
BIOTOOLS_ANNOTATION_RATE=30/min
BIOTOOLS_JOB_COOLDOWN_SECONDS=10
BIOTOOLS_JOB_STALE_AFTER_SECONDS=1800
BIOTOOLS_WORKER_POLL_SECONDS=1
BIOTOOLS_TRUST_X_FORWARDED_FOR=0
ANNOTATION_MAX_VARIANTS=200

VEP_BIN=/opt/vep/src/ensembl-vep/vep
VEP_CACHE_DIR=./data/vep
VEP_ASSEMBLY=GRCh37
VEP_MODE=local
VEP_MAX_CONCURRENCY=2
VEP_TIMEOUT_SECONDS=300
VEP_DOCKER_IMAGE=ensemblorg/ensembl-vep:release_116.0

ANNOVAR_MODE=local
ANNOVAR_DB_DIR=./data/annovar/humandb
ANNOVAR_PUBLIC_ENABLED=0
ANNOVAR_TABLE_BIN=/home/TOOLS/tools/annovar/current/bin/table_annovar.pl
ANNOVAR_MAX_CONCURRENCY=1
ANNOVAR_TIMEOUT_SECONDS=300
ANNOVAR_DOCKER_IMAGE=registry.cn-shanghai.aliyuncs.com/kszy-biosoft/annovar:v20180416_2

# Compose host mounts (optional):
# VEP_HOST_CACHE=./var/reference/vep
# VEP_HOST_CACHE_GRCh37=./var/reference/vep/homo_sapiens_merged/116_GRCh37
# ANNOVAR_HOST_DB=./var/reference/annovar/humandb

# Docker-in-Docker engine modes are intentionally not enabled by default.
# If ANNOVAR_MODE=docker or VEP_MODE=docker is required, add the Docker socket
# only in a local override file after accepting its host-level security risk.

# Optional model adapter; blank keeps evidence extraction waiting_configuration.
CURATION_MODEL_BACKEND=
# Local Django commands only; Compose fixes container paths to the existing bind mounts.
# DATABASE_PATH=./var/django/db.sqlite3
# CURATION_STORAGE_DIR=./var/library
